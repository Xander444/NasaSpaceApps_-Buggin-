{
  "name": "flame-in-freefall",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python3 simulator/api.py",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "python3 analysis/analyze.py",
    "import:psi": "python3 analysis/import_psi.py",
    "simulate": "python3 simulator/engine.py",
    "benchmark:sim": "python3 simulator/benchmark.py",
    "release:sim": "python3 simulator/build_cabin_release.py",
    "search:index": "python3 analysis/build_search_index.py",
    "test:search": "node --test src/search/*.test.js",
    "test:simulator-ui": "node --test src/simulator/*.test.js",
    "test:research-bridge": "node --test research/retrieve_service.test.mjs",
    "search:evaluate": "node analysis/evaluate_search.mjs",
    "semantic:serve": "python3 analysis/semantic_service.py",
    "check": "npm run test:search && npm run test:simulator-ui && npm run test:research-bridge && npm run test:research-ui && python3 -m unittest discover -s research -p \"test_*.py\" && python3 -m unittest discover -s analysis -p \"test_*.py\" && python3 -m unittest discover -s simulator -p \"test_*.py\" && npm run build",
    "research:summaries": "python3 research/summaries.py",
    "research:key": ".venv/bin/python scripts/research_key.py",
    "research:dev": ".venv/bin/python scripts/research_dev.py",
    "test:research": ".venv/bin/python -m unittest discover -s research -p \"test_*.py\"",
    "test:research-ui": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "vitest": "^5.1.0"
  }
}
