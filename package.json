{
  "name": "flame-in-freefall",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python3 simulator/api.py",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "python3 analysis/analyze.py",
    "import:psi": "python3 analysis/import_psi.py",
    "simulate": "python3 simulator/engine.py",
    "benchmark:sim": "python3 simulator/benchmark.py",
    "release:sim": "python3 simulator/build_cabin_release.py",
    "search:index": "python3 analysis/build_search_index.py",
    "test:search": "node --test src/search/*.test.js",
    "search:evaluate": "node analysis/evaluate_search.mjs",
    "semantic:serve": "python3 analysis/semantic_service.py",
    "check": "npm run test:search && python3 -m unittest discover -s analysis -p \"test_*.py\" && python3 -m unittest discover -s simulator -p \"test_*.py\" && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "three": "latest"
  },
  "devDependencies": {}
}
