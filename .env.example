# Optional. Leave unset for fully static keyword search.
# Restart Vite after configuring this value in .env.local.
VITE_SEMANTIC_URL=http://127.0.0.1:8765

# Backend only: use scripts/research_key.py; never put a key in a VITE_ variable.
# .env.server.local is explicitly loaded by research/config.py (not by Vite).
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=<saved only by the hidden terminal helper>
# GEMINI_ELIGIBILITY_CONFIRMED=true
