# Optional. Leave unset for fully static keyword search.
# Restart Vite after configuring this value in .env.local.
VITE_SEMANTIC_URL=http://127.0.0.1:8765

# Frontend build-time URL. Leave blank during local Vite development so /api uses the proxy.
VITE_SIMULATOR_API_URL=https://your-simulator-api.example.com

# Backend runtime settings. Use the exact public frontend origin, without a trailing slash.
SIMULATOR_ALLOWED_ORIGINS=https://your-public-frontend.example.com
SIMULATOR_MAX_CONCURRENT=2
